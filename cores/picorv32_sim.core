CAPI=2:
# Simulation Targets for PicoRV32. Stealth projection makes every fileset path
# relative to the untouched upstream repository root.
name: booley::picorv32:0
description: Booley simulation targets for the PicoRV32 RISC-V CPU core

filesets:
  rtl:
    files:
      - picorv32.v: {file_type: verilogSource}

  tb_main:
    files:
      - testbench.v: {file_type: verilogSource}
    tags: [tb]

  tb_wb:
    files:
      - testbench_wb.v: {file_type: verilogSource}
    tags: [tb]

  # Upstream hides its `testbench` modules from Verilator. This main does
  # their job around picorv32_wrapper: clock, reset, timeout and waveforms.
  # The post-setup hook copies it from .booley/sim/ into the checkout, and
  # upstream's .gitignore already ignores the name.
  verilator_main:
    files:
      - testbench_verilator_main.cc: {file_type: cppSource}
    tags: [tb]

  firmware:
    files:
      - firmware/firmware.hex: {file_type: user, copyto: firmware/firmware.hex}

parameters:
  # The upstream simulation testbenches use this preprocessor switch to set
  # the DUT's COMPRESSED_ISA module parameter.
  COMPRESSED_ISA:
    datatype: int
    default: 1
    paramtype: vlogdefine

targets:
  # Both bus testbenches run on Verilator, not Icarus: about 10x faster.
  sim_core:
    flow: sim
    flow_options:
      tool: verilator
      mode: cc
      verilator_options: [--exe, --trace, -O3, -Wno-fatal, -Wno-lint, -Wno-style]
      booley: {doctor: [sim]}
    filesets: [rtl, tb_main, verilator_main, firmware]
    toplevel: picorv32_wrapper
    parameters: [COMPRESSED_ISA]

  sim_wb:
    flow: sim
    flow_options:
      tool: verilator
      mode: cc
      # testbench_wb.v's wrapper has wb_clk and an active-high wb_rst.
      verilator_options: [--exe, --trace, -O3, -Wno-fatal, -Wno-lint, -Wno-style,
                          -CFLAGS, -DPICORV32_WB_TB]
    filesets: [rtl, tb_wb, verilator_main, firmware]
    toplevel: picorv32_wrapper
    parameters: [COMPRESSED_ISA]
